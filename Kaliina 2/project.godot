[layer_names]

3d_physics/layer_1="Ground"
2d_physics/layer_2="Pacifica"
3d_physics/layer_2="Player"
2d_physics/layer_3="Rosa"
3d_physics/layer_3="Walls"
2d_physics/layer_4="Ball"
2d_physics/layer_5="Walls"
2d_physics/layer_6="Enemies"
2d_physics/layer_7="Enemy Bullet"

[physics]

3d/physics_engine="GodotPhysics3D"

[rendering]

textures/canvas_textures/default_texture_filter=3
textures/default_filters/use_nearest_mipmap_filter=true
textures/default_filters/texture_mipmap_bias=-0.347
anti_aliasing/quality/msaa_2d=1
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_taa=true
anti_aliasing/quality/use_debanding=true
