config_version=5

[application]

config/name="Cowboy Cane"
run/main_scene="res://Scenes/Battle/Levels 3D Hand Made/Level 01.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

